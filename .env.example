# =========================================================
# Alumni Intelligence API — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit your .env file to version control.
# =========================================================

# --- PostgreSQL connection ---
DB_URL=jdbc:postgresql://localhost:5432/alumnidb
DB_USERNAME=alumni_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- PhantomBuster credentials ---
# Obtain from: https://phantombuster.com → Settings → API Keys
PHANTOMBUSTER_API_KEY=YOUR_PHANTOMBUSTER_API_KEY_HERE

# The numeric ID of your pre-configured LinkedIn Search Export Phantom
# Found in the Phantom's URL: phantombuster.com/phantoms/YOUR_AGENT_ID
PHANTOMBUSTER_AGENT_ID=YOUR_AGENT_ID_HERE

# Your LinkedIn li_at session cookie value (keep this secret)
# Instructions: https://hub.phantombuster.com/reference/how-to-get-your-linkedin-session-cookie
LINKEDIN_SESSION_COOKIE=YOUR_LI_AT_COOKIE_HERE
