{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Alumni Intelligence API",
		"description": "Production-ready Postman collection for Alumni Intelligence API.\n\nSearches LinkedIn alumni profiles by university, designation, and optional graduation year using PhantomBuster integration and persists records in PostgreSQL.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jobId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "profileId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Search Operations",
			"item": [
				{
					"name": "Trigger Alumni Search (Async Job)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 202 Accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"pm.test(\"Response contains jobId and initial status\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('jobId');",
									"    pm.expect(jsonData.status).to.be.oneOf(['PENDING', 'RUNNING', 'COMPLETED']);",
									"    pm.collectionVariables.set(\"jobId\", jsonData.jobId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"university\": \"Stanford University\",\n    \"designation\": \"Software Engineer\",\n    \"passoutYear\": 2022\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni/search",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search"
							]
						},
						"description": "Triggers an asynchronous search job on PhantomBuster and saves the job record."
					},
					"response": []
				},
				{
					"name": "Trigger Alumni Search - Validation Failure (Blank University)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Error response specifies university validation error\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(400);",
									"    pm.expect(jsonData.fieldErrors).to.be.an('array');",
									"    var universityError = jsonData.fieldErrors.find(e => e.field === 'university');",
									"    pm.expect(universityError).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"university\": \"\",\n    \"designation\": \"Software Engineer\",\n    \"passoutYear\": 2022\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni/search",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search"
							]
						},
						"description": "Demonstrates 400 Bad Request error handling when mandatory fields are omitted or blank."
					},
					"response": []
				},
				{
					"name": "Trigger Alumni Search - Validation Failure (Invalid Year)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Field error indicates passoutYear out of bounds\", function () {",
									"    var jsonData = pm.response.json();",
									"    var yearError = jsonData.fieldErrors.find(e => e.field === 'passoutYear');",
									"    pm.expect(yearError).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"university\": \"Harvard University\",\n    \"designation\": \"Product Manager\",\n    \"passoutYear\": 1820\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni/search",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search"
							]
						},
						"description": "Validates boundary constraints on passoutYear (1900 - 2100)."
					},
					"response": []
				}
			]
		},
		{
