		{
			"name": "1. Search Operations",
			"item": [
				{
					"name": "POST /api/alumni/search — Synchronous Search (Assignment Contract)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has status 'success' and 'data' array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"success\");",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    if (jsonData.data.length > 0) {",
									"        var first = jsonData.data[0];",
									"        pm.expect(first).to.have.property('name');",
									"        pm.expect(first).to.have.property('currentRole');",
									"        pm.expect(first).to.have.property('university');",
									"        if (first.id) {",
									"            pm.collectionVariables.set(\"profileId\", first.id);",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"university\": \"Stanford University\",\n    \"designation\": \"Software Engineer\",\n    \"passoutYear\": 2022\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/alumni/search",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alumni",
								"search"
							]
						},
						"description": "Primary assignment requirement: accepts university, designation, optional passoutYear, queries PhantomBuster, saves profiles to PostgreSQL, and returns the list of alumni profiles."
					},
					"response": []
				},
				{
					"name": "POST /api/alumni/search/async — Asynchronous Background Search Job",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 202 Accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"pm.test(\"Response contains jobId and initial status\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"success\");",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data.status).to.be.oneOf(['PENDING', 'RUNNING', 'COMPLETED']);",
									"    pm.collectionVariables.set(\"jobId\", jsonData.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"university\": \"MIT\",\n    \"designation\": \"Data Scientist\",\n    \"passoutYear\": 2021\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/alumni/search/async",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alumni",
								"search",
								"async"
							]
						},
						"description": "Triggers an asynchronous background search job and returns HTTP 202 with job tracking metadata."
					},
					"response": []
				},
