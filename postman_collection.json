									"    pm.expect(jsonData.errors).to.be.an('array');",
									"    var hasUniv = jsonData.errors.some(e => e.includes('university'));",
									"    pm.expect(hasUniv).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
