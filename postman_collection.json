					"name": "Get Search Job Status - Not Found (404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Error body contains not found message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni/search/999999/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search",
								"999999",
								"status"
							]
						},
						"description": "Validates proper 404 response when querying a non-existent search job ID."
					},
					"response": []
				},
				{
					"name": "Get Profiles for Specific Job",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is an array of profiles\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    if (jsonData.length > 0) {",
									"        pm.collectionVariables.set(\"profileId\", jsonData[0].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni/search/{{jobId}}/results",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search",
								"{{jobId}}",
								"results"
							]
						},
						"description": "Retrieves all alumni profiles discovered and persisted during a specific job execution."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Alumni Profiles Directory",
			"item": [
				{
					"name": "List All Alumni Profiles (Paginated)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains pagination metadata\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('content');",
									"    pm.expect(jsonData).to.have.property('totalElements');",
									"    pm.expect(jsonData).to.have.property('totalPages');",
									"    if (jsonData.content.length > 0) {",
									"        pm.collectionVariables.set(\"profileId\", jsonData.content[0].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/alumni?page=0&size=10&sort=name,asc",
