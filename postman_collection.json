							"raw": "{{baseUrl}}/api/v1/alumni/search/{{jobId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alumni",
								"search",
								"{{jobId}}",
								"status"
							]
						},
						"description": "Checks the current execution status and result count of a search job."
					},
					"response": []
